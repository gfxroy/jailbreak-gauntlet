# Leave OPENAI_API_KEY empty to run fully offline with the mock guard model.
OPENAI_API_KEY=
# auto = OpenAI if a key is set, otherwise mock. Force with "openai" or "mock".
PROVIDER=auto
OPENAI_MODEL=gpt-4.1-mini
# Optional: a separate (e.g. cheaper) model for the LLM judge and technique labeler.
OPENAI_JUDGE_MODEL=
# Optional: OpenAI-compatible endpoint.
OPENAI_BASE_URL=

DATABASE_URL=sqlite:///./gauntlet.db
# Also label attack techniques with the LLM (in addition to heuristics). Costs tokens.
CLASSIFIER_USE_LLM=false

# Level 8 rate limit
RATE_LIMIT_MAX_REQUESTS=6
RATE_LIMIT_WINDOW_SECONDS=60
