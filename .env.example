# ---------------------------------------------------------------------------
# Model provider. Leave OPENAI_API_KEY empty to run fully offline with the mock
# guard. Bring your own key; never commit it.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# auto = real model if a key is set, otherwise mock. Force with "openai" or "mock".
PROVIDER=auto
# Any OpenAI-compatible Chat Completions endpoint. Empty = api.openai.com.
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
# Guard (privileged) model. Gemini example: gemini-2.5-flash
OPENAI_MODEL=gpt-4.1-mini
# Optional per-role models (default: OPENAI_MODEL; labeler defaults to the judge model).
OPENAI_JUDGE_MODEL=
OPENAI_QUARANTINE_MODEL=
OPENAI_LABELER_MODEL=
# Optional `reasoning_effort` for thinking models ("none"/"low" recommended for gemini-2.5-*).
OPENAI_REASONING_EFFORT=
OPENAI_MAX_TOKENS=800
# Set false if your endpoint rejects response_format={"type": "json_object"}.
OPENAI_JSON_MODE=true
OPENAI_MAX_RETRIES=4
OPENAI_TIMEOUT_SECONDS=45

# Also label attack techniques with the LLM (in addition to heuristics). One extra call/message.
CLASSIFIER_USE_LLM=false

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# development | production (production: no /docs, no admin endpoints)
APP_ENV=development
# Empty = ./gauntlet.db (dev) or /data -> /tmp (production)
DATABASE_URL=
# Serve a built frontend from FastAPI (single-container deploys), e.g. ../frontend/dist
STATIC_DIR=
ENABLE_ADMIN=false
SEED_ON_STARTUP=false
MAX_INPUT_CHARS=1000

# Level 8 rate limit (in-game defense layer)
RATE_LIMIT_MAX_REQUESTS=6
RATE_LIMIT_WINDOW_SECONDS=60

# Public-demo usage limits. auto = on whenever a real model is configured.
USAGE_LIMITS=auto
VISITOR_MAX_MESSAGES=15
VISITOR_MAX_MODEL_CALLS=60
VISITOR_WINDOW_SECONDS=600
VISITOR_SESSIONS_PER_HOUR=10
GLOBAL_DAILY_MODEL_CALLS=2000
# Reverse proxies in front of the app whose X-Forwarded-For entries are trusted.
TRUSTED_PROXY_HOPS=0
